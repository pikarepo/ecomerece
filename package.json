{
  "name": "@ecomerece",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter api dev & bun run --filter @ecomerece/web dev",
    "dev:api": "bun run --filter api dev",
    "build": "bun run --filter api build && bun run --filter @ecomerece/web build && echo 'All builds completed successfully!'",
    "start": "bun run --filter api start & bun run --filter @ecomerece/web start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bun run --filter @ecomerece/web lint",
    "format": "biome format apps/web packages --write",
    "arch": "bun run scripts/arch-check.ts"
  },
  "overrides": {
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/react-dom": "^19.3.0",
    "bson": "^6.10.4",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "mongoose": "^8.24.4",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@eslint/js": "^10.0.1",
    "@next/swc-linux-x64-gnu": "16.4.5",
    "@tanstack/react-virtual": "^3.14.18",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "trustedDependencies": [
    "@clerk/shared"
  ]
}
